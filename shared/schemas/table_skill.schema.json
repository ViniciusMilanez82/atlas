{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/table_skill.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "columns", "tests"],
  "properties": {
    "format": {"const": "atlas.table.v1"},
    "columns": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["name", "op", "field"], "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "op": {"const": "copy"},
            "field": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["name", "op", "field"], "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "op": {"const": "upper"},
            "field": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["name", "op", "field"], "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "op": {"const": "lower"},
            "field": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["name", "op", "field"], "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "op": {"const": "strip"},
            "field": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
          }},
          {"type": "object", "additionalProperties": false, "required": ["name", "op", "value"], "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "op": {"const": "literal"},
            "value": {"type": ["string", "integer", "boolean", "null"], "maxLength": 1000, "minimum": -999999999999999999, "maximum": 999999999999999999}
          }},
          {"type": "object", "additionalProperties": false, "required": ["name", "op", "fields", "scale"], "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "op": {"enum": ["add", "subtract", "multiply", "divide"]},
            "fields": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}},
            "scale": {"type": "integer", "minimum": 0, "maximum": 8}
          }}
        ]
      }
    },
    "tests": {
      "type": "array", "minItems": 2, "maxItems": 12,
      "items": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["label", "rows", "expected"], "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 100},
          "rows": {"type": "array", "maxItems": 20, "items": {"type": "object", "minProperties": 1, "maxProperties": 30,
            "propertyNames": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "additionalProperties": {"type": ["string", "integer", "boolean", "null"], "maxLength": 1000, "minimum": -999999999999999999, "maximum": 999999999999999999}}},
          "expected": {"type": "array", "maxItems": 20, "items": {"type": "object", "minProperties": 1, "maxProperties": 30,
            "propertyNames": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "additionalProperties": {"type": ["string", "integer", "boolean", "null"], "maxLength": 1000, "minimum": -999999999999999999, "maximum": 999999999999999999}}}
        }},
        {"type": "object", "additionalProperties": false, "required": ["label", "rows", "expected_error"], "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 100},
          "rows": {"type": "array", "maxItems": 20, "items": {"type": "object", "minProperties": 1, "maxProperties": 30,
            "propertyNames": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
            "additionalProperties": {"type": ["string", "integer", "boolean", "null"], "maxLength": 1000, "minimum": -999999999999999999, "maximum": 999999999999999999}}},
          "expected_error": {"enum": ["MISSING_FIELD", "NOT_TEXT", "NOT_DECIMAL", "DIVIDE_BY_ZERO", "NUMBER_LIMIT"]}
        }}
      ]}
    }
  },
  "$defs": {
    "rows": {"type": "array", "maxItems": 2000, "items": {"type": "object", "minProperties": 1, "maxProperties": 30,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
      "additionalProperties": {"type": ["string", "integer", "boolean", "null"], "maxLength": 1000, "minimum": -999999999999999999, "maximum": 999999999999999999}}}
  }
}
