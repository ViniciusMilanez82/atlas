{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/config.schema.json",
  "title": "Atlas declarative configuration (spec 7.5)",
  "description": "Null budget fields mean 'pending configuration', never 'unlimited'. Security flags that would widen authority are pinned to their safe values in V1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intelligence",
    "budget",
    "security"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "intelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "default_profile",
        "profiles",
        "allow_cross_provider_fallback",
        "max_parallel_research_workers",
        "max_external_effect_workers"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "automatic",
            "economic",
            "max_quality",
            "manual"
          ]
        },
        "default_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "model_id"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "anthropic"
                ]
              },
              "model_id": {
                "description": "Real API identifier, validated against the provider before use. Never derived from a marketing name.",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.\\-]*[a-z0-9]$",
                "maxLength": 128
              }
            }
          }
        },
        "allow_cross_provider_fallback": {
          "type": "boolean"
        },
        "max_parallel_research_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_external_effect_workers": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "monthly_limit_minor",
        "per_task_limit_minor",
        "require_owner_setup_before_paid_calls",
        "warning_percentages"
      ],
      "properties": {
        "currency": {
          "$ref": "common.schema.json#/$defs/currency"
        },
        "monthly_limit_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "per_task_limit_minor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "require_owner_setup_before_paid_calls": {
          "const": true
        },
        "warning_percentages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "accept_reference_prices": {
          "type": "boolean",
          "description": "Owner accepted the unverified reference price table as an ESTIMATE for budget reservations. Never implies verified prices."
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_shell_enabled",
        "unreviewed_code_network_enabled",
        "purchases_require_scoped_approval",
        "raw_secrets_in_model_context"
      ],
      "properties": {
        "host_shell_enabled": {
          "const": false
        },
        "unreviewed_code_network_enabled": {
          "const": false
        },
        "purchases_require_scoped_approval": {
          "const": true
        },
        "raw_secrets_in_model_context": {
          "const": false
        }
      }
    }
  }
}
