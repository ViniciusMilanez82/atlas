{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/ipc_response.schema.json",
  "title": "IPC control response (spec 13.4 / 13.5)",
  "description": "Every error states whether it can be retried, what was persisted and the recommended action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["string", "null"], "maxLength": 128 },
    "result": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "data"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string", "maxLength": 2000 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["atlas_code", "retryable", "persisted", "recommended_action", "correlation_id"],
          "properties": {
            "atlas_code": { "$ref": "common.schema.json#/$defs/error_code" },
            "retryable": { "type": "boolean" },
            "persisted": { "type": "string", "maxLength": 1000 },
            "recommended_action": { "type": "string", "maxLength": 1000 },
            "correlation_id": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/correlation_id" }] }
          }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["result"], "not": { "required": ["error"] } },
    { "required": ["error"], "not": { "required": ["result"] } }
  ]
}
